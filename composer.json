{
    "name": "fourkitchens/sous-media",
    "description": "A recipe that contains modules and configuration for Sous media.",
    "keywords": ["recipe", "Drupal recipes", "drupal recipe"],
    "type": "drupal-recipe",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Laura Johnson",
            "role": "Maintainer"
        }
    ],
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "dropzone/dropzone",
                "version": "6.3.5",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "dropzone"
                },
                "dist": {
                    "url": "https://github.com/enyo/dropzone/releases/download/dropzone%406.3.5/dist.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "dropzone/dropzone": "^6.3.5",
        "drupal/field_group": "^4.0",
        "drupal/focal_point": "^2.1.3",
        "drupal/media_library_edit": "^3.0.5",
        "drupal/scheduler": "^2.3",
        "drupal/dropzonejs": "^2.11"
    }
}
